{
  "name": "vibeguard",
  "version": "1.1.0",
  "description": "CLI-native adversarial local QA daemon — intercepts git pushes, extracts diffs, analyzes via custom LLMs, fires live exploits, and auto-generates security patches before code leaves your machine.",
  "main": "dist/cli/index.js",
  "bin": {
    "vibeguard": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "build:bundle": "node scripts/build.mjs",
    "build:all": "npm run build && npm run build:bundle",
    "start": "node dist/cli/index.js",
    "test": "npx tsx --test tests/*.test.ts",
    "prepublishOnly": "npm run build:all",
    "postinstall": "node scripts/verify.mjs"
  },
  "keywords": [
    "git",
    "pre-push",
    "hook",
    "llm",
    "qa",
    "code-review",
    "security",
    "adversarial",
    "red-team",
    "vulnerability",
    "pentest",
    "devsecops",
    "ci-cd"
  ],
  "author": "VibeGuard Contributors",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.4.0"
  }
}
